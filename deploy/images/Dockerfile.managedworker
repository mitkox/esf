ARG GO_BUILDER=docker.io/library/golang@sha256:820153096fda4de6ac1b7194d12e416b7dd8f4e9a33d17e0345b111b945162d8
ARG WORKER_BASE=docker.io/library/debian@sha256:eb593cf2c358cacef45ca0a424bbc7d30cfa3466265fc2662b9466a0ca6ba1c5
FROM --platform=$BUILDPLATFORM ${GO_BUILDER} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
ARG ESF_VERSION=0.6.2
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -trimpath -ldflags="-s -w -X main.version=v${ESF_VERSION}" \
      -o /out/machinist ./cmd/machinist

FROM ${WORKER_BASE} AS managedworker
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git openssh-client && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/machinist /usr/local/bin/machinist
RUN groupadd --gid 10003 esf-worker && useradd --uid 10003 --gid 10003 --no-create-home esf-worker
USER 10003:10003
ENV HOME=/var/lib/esf/worker
ENTRYPOINT ["/usr/local/bin/machinist"]
