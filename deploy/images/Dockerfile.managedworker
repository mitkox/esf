ARG GO_BUILDER=docker.io/library/golang@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195
ARG WORKER_BASE=docker.io/library/debian@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
FROM --platform=$BUILDPLATFORM ${GO_BUILDER} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
ARG ESF_VERSION=0.5.0
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -trimpath -ldflags="-s -w -X main.version=v${ESF_VERSION}" \
      -o /out/machinist ./cmd/machinist

FROM ${WORKER_BASE} AS managedworker
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git openssh-client && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/machinist /usr/local/bin/machinist
RUN groupadd --gid 10003 esf-worker && useradd --uid 10003 --gid 10003 --no-create-home esf-worker
USER 10003:10003
ENV HOME=/var/lib/esf/worker
ENTRYPOINT ["/usr/local/bin/machinist"]
