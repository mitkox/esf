# Extend an operator-selected, digest-pinned ESF template; historical templates
# and release inventories retain their original contents.
ARG ESF_TEMPLATE_BASE
ARG NODE_BASE=docker.io/library/node@sha256:1b84b89ada025e3b14543cbb837ffaa1c1b5273b841c5b94dd1a8f9c1d8cf7fe
FROM ${NODE_BASE} AS node-runtime
FROM ${ESF_TEMPLATE_BASE} AS pi-template-v1
COPY --from=node-runtime /usr/local/bin/node /opt/esf/agents/node
COPY agents/pi/dist/pi-runner.mjs /opt/esf/agents/pi-runner.mjs
COPY agents/pi/inventory.json /opt/esf/pi-inventory.json
COPY agents/pi/dist/THIRD_PARTY_NOTICES.txt /opt/esf/pi-third-party-notices.txt
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 && rm -rf /var/lib/apt/lists/* && \
    chmod 0755 /opt/esf/agents/node && \
    echo 'caa24debe02770c92a70677e2a62ca98890150e7ac1c17bcfe31bcc98cc89943  /opt/esf/agents/node' | sha256sum -c - && \
    echo '04bd662ac31ca6e74775a6b0c03403d66030c44855a9840607e95ab2fcf89bf5  /opt/esf/agents/pi-runner.mjs' | sha256sum -c -
LABEL org.opencontainers.image.title="ESF Pi template v1 candidate" \
      io.esf.pi.contract="esf/pi/v1" io.esf.pi.durable.version="1.2.0"
