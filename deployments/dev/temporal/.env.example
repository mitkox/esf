# Copy to .env and replace the database password before starting.
COMPOSE_PROJECT_NAME=factory-temporal
TEMPORAL_VERSION=1.32.1
TEMPORAL_ADMINTOOLS_VERSION=1.32.1
TEMPORAL_UI_VERSION=2.56.0
POSTGRESQL_VERSION=18.6-alpine
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_NAMESPACE=default
POSTGRES_USER=temporal
POSTGRES_PASSWORD=replace-with-a-random-local-password

# PostgreSQL 18+ uses a new volume: migrate an existing 16.x database first.
POSTGRESQL_DATA_VOLUME=factory-temporal-postgresql-data-v18
# Use upgrade after restoring an existing Temporal database and visibility store.
TEMPORAL_SCHEMA_MODE=create
